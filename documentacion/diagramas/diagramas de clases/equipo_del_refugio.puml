@startuml equipo_del_refugio

skinparam Linetype ortho

class Usuario <<Model>> {
  Id : Guid
  Email : string
  PasswordHash : string
  Nombre : string
  Apellido : string
  Telefono : string
  Rol : RolUsuario
  RolRefugio : RolRefugio
  RefugioId : Guid <<FK>>
  Activo : bool
  FechaAlta : DateTime
}

class MiembroEquipoResponse <<DTO>> {
  Id : Guid
  Nombre : string
  Apellido : string
  Email : string
  Telefono : string
  RolRefugio : RolRefugio
  Activo : bool
  FechaAlta : DateTime
}

class ColaboradorRequest <<DTO>> {
  Email : string
  Password : string
  Nombre : string
  Apellido : string
  Telefono : string
}

class ColaboradorResult <<DTO>> {
  Colaborador : MiembroEquipoResponse
  Error : string
}

class BlanquearPasswordRequest <<DTO>> {
  PasswordNueva : string
}

class RefugioController <<Controller>> {
  ListarEquipo() : IActionResult
  AgregarColaborador(request : ColaboradorRequest) : IActionResult
  BloquearColaborador(id : Guid) : IActionResult
  DesbloquearColaborador(id : Guid) : IActionResult
  BlanquearPasswordColaborador(id : Guid, request : BlanquearPasswordRequest) : IActionResult
}

interface IRefugioService <<Service>> {
  ListarEquipoAsync(refugioId : Guid) : List<MiembroEquipoResponse>
  AgregarColaboradorAsync(fundadorId : Guid, refugioId : Guid, request : ColaboradorRequest) : ColaboradorResult
  CambiarEstadoColaboradorAsync(fundadorId : Guid, refugioId : Guid, colaboradorId : Guid, activo : bool) : string
  BlanquearPasswordColaboradorAsync(fundadorId : Guid, refugioId : Guid, colaboradorId : Guid, passwordNueva : string) : string
}

class RefugioService <<Service>>

enum RolUsuario {
  Admin
  Refugio
  Usuario
}

enum RolRefugio {
  Fundador
  Colaborador
}

/' Relaciones '/
RefugioController ..> IRefugioService
RefugioController ..> BlanquearPasswordRequest
IRefugioService <|.. RefugioService
RefugioService ..> Usuario
RefugioService ..> MiembroEquipoResponse
RefugioService ..> ColaboradorRequest
RefugioService ..> ColaboradorResult

Usuario ..> RolUsuario
Usuario ..> RolRefugio
MiembroEquipoResponse ..> RolRefugio

@enduml