@page
@model TransitAR.Web.Pages.Admin.UsuariosModel
@{
    ViewData["Title"] = "Usuarios";

    var roles = new (RolUsuario? Rol, string Nombre)[]
    {
        (null, "Todos"),
        (RolUsuario.Refugio, "Refugios"),
        (RolUsuario.Usuario, "Postulantes")
    };

    var estados = new (bool? Activo, string Nombre)[]
    {
        (null, "Todos"),
        (true, "Activos"),
        (false, "Bloqueados")
    };
}

<h1 class="h3 mb-1">Usuarios</h1>
<p class="text-muted">Un usuario bloqueado no puede iniciar sesión. Al administrador no se lo puede bloquear.</p>

@if (Model.Mensaje != null)
{
    <div class="alert alert-success">@Model.Mensaje</div>
}

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}


<ul class="nav nav-pills mb-2">
    @foreach (var r in roles)
    {
        <li class="nav-item">
            <a asp-page="/Admin/Usuarios" asp-route-rol="@r.Rol" asp-route-activo="@Model.Activo"
               class="nav-link @(Model.Rol == r.Rol ? "active" : "")">
                @r.Nombre <span class="badge bg-light text-dark ms-1">@Model.Cantidad(r.Rol, Model.Activo)</span>
            </a>
        </li>
    }
</ul>

<ul class="nav nav-pills mb-3">
    @foreach (var e in estados)
    {
        <li class="nav-item">
            <a asp-page="/Admin/Usuarios" asp-route-rol="@Model.Rol" asp-route-activo="@e.Activo"
               class="nav-link @(Model.Activo == e.Activo ? "active" : "")">
                @e.Nombre <span class="badge bg-light text-dark ms-1">@Model.Cantidad(Model.Rol, e.Activo)</span>
            </a>
        </li>
    }
</ul>

@if (!Model.Usuarios.Any())
{
    <partial name="_AvisoSinDatos" model='new AvisoSinDatos("bi-inbox", "No hay usuarios con estos filtros.")' />
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Alta</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Usuarios)
                {
                    <tr class="@(u.Activo ? "" : "opacity-75")">
                        <td>@u.Nombre @u.Apellido</td>
                        <td>@u.Email</td>
                        <td>@Formato.Rol(u.Rol)</td>
                        <td>@Formato.FechaDe(u.FechaAlta)</td>
                        <td>
                            <span class="badge @(u.Activo ? "bg-success" : "bg-danger")">@(u.Activo ? "Activo" : "Bloqueado")</span>
                        </td>
                        <td class="text-end">
                            @if (u.Rol == RolUsuario.Admin)
                            {
                                <span class="text-muted small">—</span>
                            }
                            else
                            {
                                @if (u.Activo)
                                {
                                    <form method="post" asp-page-handler="Bloquear" asp-route-id="@u.Id"
                                          asp-route-rol="@Model.Rol" asp-route-activo="@Model.Activo"
                                          data-confirmar="¿Bloquear a @u.Nombre @u.Apellido? No va a poder iniciar sesión." data-confirmar-boton="Bloquear">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-slash-circle me-1"></i>Bloquear</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Desbloquear" asp-route-id="@u.Id"
                                          asp-route-rol="@Model.Rol" asp-route-activo="@Model.Activo">
                                        <button type="submit" class="btn btn-sm btn-outline-success"><i class="bi bi-check-circle me-1"></i>Desbloquear</button>
                                    </form>
                                }

                                <button type="button" class="btn btn-sm btn-outline-secondary mt-1"
                                        data-bs-toggle="modal" data-bs-target="#modalBlanquear"
                                        data-nombre="@u.Nombre @u.Apellido"
                                        data-url="@Url.Page("/Admin/Usuarios", "Blanquear", new { id = u.Id, rol = Model.Rol, activo = Model.Activo })">
                                    <i class="bi bi-key me-1"></i>Blanquear
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    var prevDisabled = !Model.Usuarios.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.Usuarios.HasNextPage ? "disabled" : "";

    <nav aria-label="Paginación">
        <ul class="pagination pagination-sm justify-content-center align-items-center gap-3 mt-4">
            <li class="page-item @prevDisabled">
                <a class="page-link rounded" asp-page="./Usuarios"
                   asp-route-rol="@Model.Rol" asp-route-activo="@Model.Activo"
                   asp-route-pageIndex="@(Model.Usuarios.PageIndex - 1)"><i class="bi bi-chevron-left me-1"></i>Anterior</a>
            </li>
            <li class="page-item disabled">
                <a class="page-link border-0 bg-transparent">Página @Model.Usuarios.PageIndex de @Model.Usuarios.TotalPages</a>
            </li>
            <li class="page-item @nextDisabled">
                <a class="page-link rounded" asp-page="./Usuarios"
                   asp-route-rol="@Model.Rol" asp-route-activo="@Model.Activo"
                   asp-route-pageIndex="@(Model.Usuarios.PageIndex + 1)">Siguiente<i class="bi bi-chevron-right ms-1"></i></a>
            </li>
        </ul>
    </nav>
}

<partial name="_ModalBlanquear" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}