@model List<MensajeResponse>

@{
    //url chat para armar el link de cada adjunto 
    var postulacionId = ViewContext.RouteData.Values["postulacionId"];
}


@if (!Model.Any())
{
    <p class="text-muted text-center my-5">Todavía no hay mensajes. Escribí el primero.</p>
}

@foreach (var m in Model)
{
    <div class="d-flex mb-3 @(m.EsPropio ? "justify-content-end" : "justify-content-start")">
        <div class="burbuja rounded-3 px-3 py-2 @(m.EsPropio ? "bg-primary text-white" : "bg-light border")">
            @if (!m.EsPropio)
            {
                <div class="small fw-semibold">@m.EmisorNombre</div>
            }

            @if (!string.IsNullOrWhiteSpace(m.Texto))
            {
                <div class="texto-con-saltos">@m.Texto</div>
            }

            @if (m.Adjuntos.Any())
            {
                <div class="d-flex flex-wrap gap-2 mt-1">
                    @foreach (var a in m.Adjuntos)
                    {
                        var url = Url.Page("/Mensajes/Chat", "Adjunto", new { postulacionId, adjuntoId = a.Id });

                        @if (a.ContentType.StartsWith("image/"))
                        {
                            <a href="@url" target="_blank" title="@a.NombreArchivo">
                                <img src="@url" class="adjunto-mini rounded" alt="@a.NombreArchivo" />
                            </a>
                        }
                        else
                        {
                            <div class="small">
                                @a.NombreArchivo
                                <a href="@url" target="_blank" class="@(m.EsPropio ? "link-light" : "")">Ver</a>
                                ·
                                <a href="@url" download="@a.NombreArchivo" class="@(m.EsPropio ? "link-light" : "")">Descargar</a>
                            </div>
                        }
                    }
                </div>
            }

            <div class="small mt-1 text-end @(m.EsPropio ? "text-white-50" : "text-muted")">
                @Formato.Instante(m.FechaEnvio)
                @if (m.EsPropio)
                {
                    <span>· @(m.FechaLectura != null ? "✓ Leído" : "Enviado")</span>
                }
            </div>
        </div>
    </div>
}