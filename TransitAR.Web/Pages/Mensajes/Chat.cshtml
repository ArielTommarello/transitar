@page "{postulacionId:guid}"
@model TransitAR.Web.Pages.Mensajes.ChatModel
@{
    ViewData["Title"] = Model.Chat?.MascotaNombre ?? "Mensajes";
}

<a asp-page="/Mensajes/Index" class="small">&larr; Volver a Mensajes</a>

@if (Model.Chat == null)
{
    <div class="text-center py-5">
        <h1 class="h4">No encontramos esta conversación</h1>
        <p class="text-muted">Puede que el link esté mal o que no sea tuya.</p>
        <a asp-page="/Mensajes/Index" class="btn btn-primary">Ir a Mensajes</a>
    </div>
    return;
}

@{
    var c = Model.Chat;
    var estado = User.IsInRole("Refugio") ? Formato.EstadoParaRefugio(c.EstadoPostulacion) : Formato.Estado(c.EstadoPostulacion);
}

<div class="d-flex justify-content-between align-items-center mt-2 mb-3">
    <div>
        <h1 class="h4 mb-0">@c.MascotaNombre <span class="text-muted fw-normal">· @c.Receptor</span></h1>
        <div class="small text-muted">@c.PublicacionTitulo · @Formato.Tipo(c.Tipo) · @estado</div>
    </div>
    <a asp-page="/Mensajes/Chat" asp-route-postulacionId="@c.PostulacionId" class="btn btn-sm btn-outline-secondary">Actualizar</a>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

@* -- Mensajes (actualizacion 15 segundos) -- *@
<div id="mensajes" class="chat-mensajes border rounded p-3 mb-3"
     data-url="@Url.Page("/Mensajes/Chat", "Mensajes", new { postulacionId = c.PostulacionId })"
     data-actualizar="@(c.PuedeEscribir ? "si" : "no")">
    <partial name="_Mensajes" model="c.Mensajes" />
</div>

@if (c.PuedeEscribir)
{
    <form id="formEnviar" method="post" asp-page-handler="Enviar" enctype="multipart/form-data" class="mb-5">
        <div class="d-flex gap-2 align-items-end">
            <textarea name="Texto" class="form-control" rows="2" maxlength="2000"
                      placeholder="Escribí un mensaje…"></textarea>
            <button type="submit" class="btn btn-primary">Enviar</button>
        </div>
        <div class="mt-2">
            @* cambia si cambia la regla , esta en default *@
            <input type="file" id="archivos" name="Archivos" class="form-control form-control-sm" multiple
                   accept="image/jpeg,image/png,image/webp,video/mp4"
                   data-max-archivos="3" data-max-mb="9" />
            <div id="errorArchivos" class="text-danger small mt-1 d-none"></div>
            <div class="form-text">Opcional: hasta 3 fotos (jpg, png, webp) o videos mp4, de 9 MB cada uno.</div>
        </div>
    </form>
}
else
{
    <div class="alert alert-secondary mb-5">
        Esta conversación está cerrada: podés leerla, pero ya no se pueden mandar mensajes.
    </div>
}

@section Scripts {
    <script>
        (function () {
            //reviso antes de enviar la cant y tamñao para los adjuntos
            const form = document.getElementById('formEnviar');
            if (form) {
                form.addEventListener('submit', e => {
                    const input = document.getElementById('archivos');
                    const caja = document.getElementById('errorArchivos');
                    const maxArchivos = Number(input.dataset.maxArchivos);
                    const maxMB = Number(input.dataset.maxMb);
                    const archivos = Array.from(input.files);

                    ///muestro el error
                    let error = null;
                    if (archivos.length > maxArchivos) {
                        error = `Se pueden adjuntar hasta ${maxArchivos} archivos por mensaje.`;
                    } else {
                        const grande = archivos.find(a => a.size > maxMB * 1024 * 1024);
                        if (grande) error = `El archivo ${grande.name} supera los ${maxMB} MB permitidos.`;
                    }
                                        
                    if (error) {
                        e.preventDefault(); //no se manda
                        caja.textContent = error;
                        caja.classList.remove('d-none');
                    } else {
                        caja.classList.add('d-none');
                    }
                });
            }

            const lista = document.getElementById('mensajes');
            const bajar = () => lista.scrollTop = lista.scrollHeight;

            //al entrar, mostrar lo ultimo
            bajar();

            //sie sta cerrada, solo lectura
            if (lista.dataset.actualizar !== 'si') return;

            actualizarCada(lista, 15, {
                //si esta arriba leyendo, queda ahi como wpp
                antes: () => lista.scrollHeight - lista.scrollTop - lista.clientHeight < 40,
                despues: estabaAbajo => { if (estabaAbajo) bajar(); }
            });
        })();
    </script>
}