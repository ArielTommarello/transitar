@page
@model TransitAR.Web.Pages.Mensajes.IndexModel
@{
    ViewData["Title"] = "Mensajes";
}

<h1 class="h3 mb-3">Mensajes</h1>

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (Model.Filtrada)
{
    <div class="alert alert-light border d-flex justify-content-between align-items-center">
        <span>Mostrando las conversaciones de <strong>@(Model.MascotaNombre ?? "esta publicación")</strong>.</span>
        <a asp-page="/Mensajes/Index" class="alert-link">Ver todas</a>
    </div>
}

@* -- Deberia actualizarse cada 15s dios!!!!! -- *@
<div id="chats"
     data-url="@Url.Page("/Mensajes/Index", "Chats", new { publicacionId = Model.PublicacionId, mascotaId = Model.MascotaId, pageIndex = Model.ChatsPagina.PageIndex })">
    <partial name="_Chats" model="Model.ChatsPagina" />
</div>

@if (Model.Chats.Any())
{
    var prevDisabled = !Model.ChatsPagina.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.ChatsPagina.HasNextPage ? "disabled" : "";

    <nav aria-label="Paginación" class="mb-5">
        <ul class="pagination pagination-sm justify-content-center align-items-center gap-3 mt-4">
            <li class="page-item @prevDisabled">
                <a class="page-link rounded" asp-page="./Index" asp-route-publicacionId="@Model.PublicacionId" asp-route-mascotaId="@Model.MascotaId"
                   asp-route-pageIndex="@(Model.ChatsPagina.PageIndex - 1)"><i class="bi bi-chevron-left me-1"></i>Anterior</a>
            </li>
            <li class="page-item disabled">
                <a class="page-link border-0 bg-transparent">Página @Model.ChatsPagina.PageIndex de @Model.ChatsPagina.TotalPages</a>
            </li>
            <li class="page-item @nextDisabled">
                <a class="page-link rounded" asp-page="./Index" asp-route-publicacionId="@Model.PublicacionId" asp-route-mascotaId="@Model.MascotaId"
                   asp-route-pageIndex="@(Model.ChatsPagina.PageIndex + 1)">Siguiente<i class="bi bi-chevron-right ms-1"></i></a>
            </li>
        </ul>
    </nav>
}

@section Scripts {
    <script>
        actualizarCada(document.getElementById('chats'), 15);
    </script>
}