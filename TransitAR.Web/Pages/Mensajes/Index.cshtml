@page
@model TransitAR.Web.Pages.Mensajes.IndexModel
@{
    ViewData["Title"] = "Mensajes";
}

<h1 class="h3 mb-3">Mensajes</h1>

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (Model.Filtrada)
{
    <div class="alert alert-light border d-flex justify-content-between align-items-center">
        <span>Mostrando las conversaciones de <strong>@(Model.MascotaNombre ?? "esta publicación")</strong>.</span>
        <a asp-page="/Mensajes/Index" class="alert-link">Ver todas</a>
    </div>
}

@* -- Deberia actualizarse cada 15s dios!!!!! -- *@
<div id="chats" class="mb-5"
     data-url="@Url.Page("/Mensajes/Index", "Chats", new { publicacionId = Model.PublicacionId, mascotaId = Model.MascotaId })">
    <partial name="_Chats" model="Model.Chats" />
</div>

@section Scripts {
    <script>
        actualizarCada(document.getElementById('chats'), 15);
    </script>
}