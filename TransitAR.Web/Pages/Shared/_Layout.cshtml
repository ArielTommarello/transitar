<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TransitAR</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TransitAR.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-primary shadow-sm mb-4" data-bs-theme="dark">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-page="/Index"><i class="bi bi-house-heart-fill me-2"></i>TransitAR</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.IsInRole("Refugio"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Refugio/Panel">Panel</a></li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Mascotas</a>
                                <ul class="dropdown-menu" data-bs-theme="light">
                                    <li><a class="dropdown-item" asp-page="/Refugio/Mascotas">Mascotas</a></li>
                                    <li><a class="dropdown-item" asp-page="/Refugio/Publicaciones">Publicaciones</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Seguimiento</a>
                                <ul class="dropdown-menu" data-bs-theme="light">
                                    <li><a class="dropdown-item" asp-page="/Refugio/Tenencias">Tenencias</a></li>
                                    <li><a class="dropdown-item" asp-page="/Refugio/Seguimiento">Seguimiento</a></li>
                                </ul>
                            </li>
                            <partial name="_MenuMensajes" />
                        }
                        else if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Admin/Catalogos">Especies y condiciones</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Admin/Usuarios">Usuarios</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Admin/Refugios">Refugios</a></li>
                        }
                        else
                        {
                            @* sin sesion o postulante: entra por publicaciones *@
                            <li class="nav-item"><a class="nav-link" asp-page="/Publicaciones/Index">Publicaciones</a></li>

                            @if (User.IsInRole("Usuario"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-page="/Postulante/Postulaciones">Mis postulaciones</a></li>
                                <li class="nav-item"><a class="nav-link" asp-page="/Postulante/Tenencias">Mis tenencias</a></li>
                                <partial name="_MenuMensajes" />
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i>Hola, @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" data-bs-theme="light">
                                    @if (User.IsInRole("Refugio"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Refugio/Perfil"><i class="bi bi-house me-2"></i>Perfil del refugio</a></li>
                                        <li><a class="dropdown-item" asp-page="/Refugio/Equipo"><i class="bi bi-people me-2"></i>Equipo</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    else if (User.IsInRole("Usuario"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Postulante/Perfil"><i class="bi bi-person me-2"></i>Mi perfil</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li><a class="dropdown-item" asp-page="/Cuenta/CambiarPassword"><i class="bi bi-key me-2"></i>Cambiar contraseña</a></li>
                                    <li>
                                        <form method="post" asp-page="/Cuenta/Logout">
                                            <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Salir</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Cuenta/Login">Iniciar sesión</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Cuenta/RegistroPostulante">Crear cuenta</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <div class="modal fade" id="modalConfirmar" tabindex="-1" aria-labelledby="modalConfirmarTitulo" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="modalConfirmarTitulo">Confirmar</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body" id="modalConfirmarTexto"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Volver</button>
                    <button type="button" class="btn btn-primary" id="modalConfirmarAceptar">Confirmar</button>
                </div>
            </div>
        </div>
    </div>


    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 TransitAR · Proyecto de Práctica Profesional Supervisada UTN · <a asp-area="" asp-page="/Privacy">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        actualizarCada(document.getElementById('noLeidos'), 30, { ahora: true });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
