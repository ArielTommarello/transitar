<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TransitAR</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TransitAR.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-primary shadow-sm mb-4" data-bs-theme="dark">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-page="/Index"><i class="bi bi-house-heart-fill me-2"></i>TransitAR</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.IsInRole("Refugio"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Refugio/Panel">Panel</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Refugio/Mascotas">Mascotas</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Refugio/Publicaciones">Publicaciones</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Refugio/Tenencias">Tenencias</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Refugio/Seguimiento">Seguimiento</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Refugio/Equipo">Equipo</a></li>
                            <partial name="_MenuMensajes" />
                            <li class="nav-item"><a class="nav-link" asp-page="/Refugio/Perfil">Perfil del refugio</a></li>
                        }
                        else if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Admin/Catalogos">Especies y condiciones</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Admin/Usuarios">Usuarios</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Admin/Refugios">Refugios</a></li>
                        }
                        else
                        {
                            @* sin sesion o postulante: entra por publicacioens *@
                            <li class="nav-item"><a class="nav-link" asp-page="/Publicaciones/Index">Publicaciones</a></li>

                            @if (User.IsInRole("Usuario"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-page="/Postulante/Postulaciones">Mis postulaciones</a></li>
                                <li class="nav-item"><a class="nav-link" asp-page="/Postulante/Tenencias">Mis tenencias</a></li>
                                <partial name="_MenuMensajes" />
                                <li class="nav-item"><a class="nav-link" asp-page="/Postulante/Perfil">Mi perfil</a></li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="nav-link">Hola, @User.Identity.Name</span>
                            </li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Cuenta/CambiarPassword">Cambiar contraseña</a></li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Cuenta/Logout" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-link">Salir</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Cuenta/Login">Iniciar sesión</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Cuenta/RegistroPostulante">Crear cuenta</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 TransitAR · Proyecto de Práctica Profesional Supervisada UTN · <a asp-area="" asp-page="/Privacy">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        actualizarCada(document.getElementById('noLeidos'), 30, { ahora: true });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
