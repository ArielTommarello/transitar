@page
@model TransitAR.Web.Pages.Cuenta.CambiarPasswordModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 mb-4">Cambiar contraseña</h1>

        @if (Model.Mensaje != null)
        {
            <div class="alert alert-success">@Model.Mensaje</div>
        }
        @if (Model.Error != null)
        {
            <div class="alert alert-danger">@Model.Error</div>
        }

        <form method="post">
            <div class="mb-3">
                <label asp-for="Datos.PasswordActual" class="form-label"></label>
                <input asp-for="Datos.PasswordActual" type="password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Datos.PasswordActual" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Datos.PasswordNueva" class="form-label"></label>
                <input asp-for="Datos.PasswordNueva" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Datos.PasswordNueva" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Datos.ConfirmarPassword" class="form-label"></label>
                <input asp-for="Datos.ConfirmarPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Datos.ConfirmarPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Guardar</button>
        </form>
       
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
