@page
@model TransitAR.Web.Pages.Cuenta.RegistroPostulanteModel
@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="h3 mb-1">Crear cuenta</h1>
        <p class="text-muted mb-4">Para postularte a adoptar o transitar.</p>

        @if (Model.Error != null)
        {
            <div class="alert alert-danger">@Model.Error</div>
        }

        <form method="post">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Datos.Nombre" class="form-label">Nombre</label>
                    <input asp-for="Datos.Nombre" class="form-control" />
                    <span asp-validation-for="Datos.Nombre" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Datos.Apellido" class="form-label">Apellido</label>
                    <input asp-for="Datos.Apellido" class="form-control" />
                    <span asp-validation-for="Datos.Apellido" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Datos.Email" class="form-label">Email</label>
                <input asp-for="Datos.Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Datos.Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Datos.Telefono" class="form-label">Teléfono <span class="text-muted">(opcional)</span></label>
                <input asp-for="Datos.Telefono" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Datos.Password" class="form-label">Contraseña</label>
                <input asp-for="Datos.Password" type="password" class="form-control" autocomplete="new-password" />
                <div class="form-text">Mínimo 8 caracteres.</div>
                <span asp-validation-for="Datos.Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Crear cuenta</button>
        </form>

        <p class="mt-3 text-center small">
            ¿Sos un refugio? <a asp-page="/Cuenta/RegistroRefugio">Registrá tu refugio</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}