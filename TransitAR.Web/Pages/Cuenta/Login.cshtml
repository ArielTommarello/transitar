@page
@model TransitAR.Web.Pages.Cuenta.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 mb-4">Iniciar sesión</h1>

        @if (Model.Error != null)
        {
            <div class="alert alert-danger">@Model.Error</div>
        }

        <form method="post">
            <div class="mb-3">
                <label asp-for="Datos.Email" class="form-label">Email</label>
                <input asp-for="Datos.Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Datos.Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Datos.Password" class="form-label">Contraseña</label>
                <input asp-for="Datos.Password" type="password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Datos.Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Ingresar</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
