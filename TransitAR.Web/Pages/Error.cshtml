@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="h3">Algo salió mal</h1>
<p class="text-muted">Probá de nuevo en un rato.</p>
<a asp-page="/Index" class="btn btn-primary">Volver al inicio</a>

@if (Model.ShowRequestId)
{
    <p class="small text-muted mt-3">Código del error: <code>@Model.RequestId</code></p>
}
