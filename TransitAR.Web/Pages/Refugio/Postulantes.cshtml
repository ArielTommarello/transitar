@page "{id:guid}"
@model TransitAR.Web.Pages.Refugio.PostulantesModel
@{
    ViewData["Title"] = "Postulaciones";
}

<a asp-page="/Refugio/Publicaciones" class="btn btn-sm bg-primary-subtle text-primary border border-primary-subtle mb-2"><i class="bi bi-chevron-left me-1"></i>Volver a Publicaciones</a>

@if (Model.NoEncontrada || Model.Publicacion == null)
{
    <div class="text-center py-5">
        <h1 class="h4">No encontramos esta publicación</h1>
        <p class="text-muted">Puede que el link esté mal o que no sea de tu refugio.</p>
        <a asp-page="/Refugio/Publicaciones" class="btn btn-primary">Ir a Publicaciones</a>
    </div>
    return;
}

@{
    var p = Model.Publicacion;

    //tipo de publicacion y id de pub y piublicacion cerrada
    var datosTarjeta = new ViewDataDictionary(ViewData)
            {
                ["TipoPublicacion"] = p.Tipo,
                ["PublicacionId"] = p.Id,
                ["PublicacionCerrada"] = p.Estado == EstadoPublicacion.Cerrada
            };
}

<div class="row justify-content-center mt-2">
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <h1 class="h3 mb-0">Postulaciones</h1>
            <span class="badge @Formato.ColorEstadoPublicacion(p.Estado)">@Formato.EstadoPublicacion(p.Estado)</span>
        </div>
        <p class="text-muted mb-4">@p.Titulo · @p.MascotaNombre · @Formato.Tipo(p.Tipo)</p>

        @if (Model.Aceptada == null && !Model.EnEvaluacion.Any() && !Model.Finalizadas.Any())
        {
            <partial name="_AvisoSinDatos" model='new AvisoSinDatos("bi-person-lines-fill", "Todavía nadie se postuló a esta publicación.")' />
        }

        @if (Model.Aceptada != null)
        {
            @if (p.Estado == EstadoPublicacion.Cerrada)
            {
                <h2 class="h5 mb-3">Se le entregó</h2>
            }
            else
            {
                <h2 class="h5 mb-3">Aceptada</h2>
                <p class="small text-muted">La publicación está pausada hasta que confirmes la entrega o la rechaces.</p>
            }
            <partial name="_TarjetaPostulante" model="Model.Aceptada" view-data="datosTarjeta" />
        }

        @if (Model.EnEvaluacion.Any() || Model.Finalizadas.Any())
        {
            <ul class="nav nav-pills mt-4 mb-3">
                <li class="nav-item">
                    <a asp-page="./Postulantes" asp-route-id="@p.Id" asp-route-verFinalizadas="false"
                       class="nav-link @(!Model.VerFinalizadas ? "active" : "")">
                        En evaluación <span class="badge bg-light text-dark ms-1">@Model.EnEvaluacion.Count</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-page="./Postulantes" asp-route-id="@p.Id" asp-route-verFinalizadas="true"
                       class="nav-link @(Model.VerFinalizadas ? "active" : "")">
                        Finalizadas <span class="badge bg-light text-dark ms-1">@Model.Finalizadas.Count</span>
                    </a>
                </li>
            </ul>

            @if (!Model.Postulaciones.Any())
            {
                <partial name="_AvisoSinDatos" model='new AvisoSinDatos("bi-inbox", "No hay postulaciones para mostrar.")' />
            }
            else
            {
                foreach (var postulacion in Model.Postulaciones)
                {
                    <partial name="_TarjetaPostulante" model="postulacion" view-data="datosTarjeta" />
                }

                var prevDisabled = !Model.Postulaciones.HasPreviousPage ? "disabled" : "";
                var nextDisabled = !Model.Postulaciones.HasNextPage ? "disabled" : "";

                <nav aria-label="Paginación">
                    <ul class="pagination pagination-sm justify-content-center align-items-center gap-3 mt-4">
                        <li class="page-item @prevDisabled">
                            <a class="page-link rounded" asp-page="./Postulantes" asp-route-id="@p.Id" asp-route-verFinalizadas="@Model.VerFinalizadas"
                               asp-route-pageIndex="@(Model.Postulaciones.PageIndex - 1)"><i class="bi bi-chevron-left me-1"></i>Anterior</a>
                        </li>
                        <li class="page-item disabled">
                            <a class="page-link border-0 bg-transparent">Página @Model.Postulaciones.PageIndex de @Model.Postulaciones.TotalPages</a>
                        </li>
                        <li class="page-item @nextDisabled">
                            <a class="page-link rounded" asp-page="./Postulantes" asp-route-id="@p.Id" asp-route-verFinalizadas="@Model.VerFinalizadas"
                               asp-route-pageIndex="@(Model.Postulaciones.PageIndex + 1)">Siguiente<i class="bi bi-chevron-right ms-1"></i></a>
                        </li>
                    </ul>
                </nav>
            }
        }         
    </div>
</div>