@model TransitAR.Structures.PostulacionRefugioResponse

@{
    var tipoPublicacion = (TipoPublicacion)ViewData["TipoPublicacion"]!;
    var publicacionId = (Guid)ViewData["PublicacionId"]!;
    var aviso = Formato.AvisoSeleccion(Model.Seleccion, tipoPublicacion);
}

<div class="card mb-3">
    <div class="card-body d-flex gap-3 align-items-start">
        @if (Model.FotoPerfil)
        {
            <img src="@Api.UrlFotoPostulante(Model.UsuarioId)" class="postulante-mini rounded-circle" alt="Foto de @Model.Nombre" />
        }
        else
        {
            <div class="postulante-mini perfil-sin-foto rounded-circle">@Model.Nombre[..1]@Model.Apellido[..1]</div>
        }

        <div class="flex-grow-1">
            <div class="d-flex justify-content-between align-items-start gap-2">
                <div>
                    <strong>@Model.Nombre @Model.Apellido</strong>
                    <div class="small text-muted">Se postuló el @Formato.FechaDe(Model.FechaPostulacion)</div>
                </div>
                <span class="badge @Formato.ColorEstado(Model.Estado)">@Formato.EstadoParaRefugio(Model.Estado)</span>
            </div>

            <div class="small mt-2">
                Busca: @Formato.Seleccion(Model.Seleccion)
                @if (aviso != null)
                {
                    <span class="badge bg-warning text-dark ms-1">@aviso</span>
                }
            </div>

            <div class="small text-muted">
                @(Model.TipoVivienda ?? "Vivienda sin indicar")
                · @(Model.TienePatio ? (Model.PatioCerrado ? "Patio cerrado" : "Patio abierto") : "Sin patio")
                · @(Model.TieneOtrasMascotas ? "Tiene otras mascotas" : "Sin otras mascotas")
                @if (Model.HorasSoloPorDia != null)
                {
                    <text>· Solo @Model.HorasSoloPorDia h por día</text>
                }
            </div>

            <div class="text-end mt-2">
                <a asp-page="/Refugio/Postulante" asp-route-publicacionId="@publicacionId" asp-route-postulacionId="@Model.Id"
                   class="btn btn-sm btn-outline-primary">Ver postulante</a>
            </div>
        </div>
    </div>
</div>