@page "{id:guid?}"
@model TransitAR.Web.Pages.Refugio.MascotaModel
@{
    var esNueva = Model.Id == null;
    ViewData["Title"] = esNueva ? "Nueva mascota" : $"Editar a {Model.Mascota?.Nombre}";
}

<a asp-page="/Refugio/Mascotas" class="small">&larr; Volver a Mascotas</a>

@if (Model.NoEncontrada)
{
    <div class="text-center py-5">
        <h1 class="h4">No encontramos esta mascota</h1>
        <p class="text-muted">Puede que el link esté mal o que no sea de tu refugio.</p>
        <a asp-page="/Refugio/Mascotas" class="btn btn-primary">Ir a Mascotas</a>
    </div>
    return;
}

<div class="row justify-content-center mt-2">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-1">


            <h1 class="h3 mb-0">@ViewData["Title"]</h1>
            @if (Model.Mascota != null)
            {
                <span class="badge @Formato.ColorEstadoMascota(Model.Mascota.Estado)">@Formato.EstadoMascota(Model.Mascota.Estado)</span>
            }
        </div>

        @if (Model.Mascota != null)
        {
            <p class="text-muted small mb-3">
                Cargada el @Formato.FechaDe(Model.Mascota.FechaAlta)
                (hace @Formato.Dias((DateTime.UtcNow - Model.Mascota.FechaAlta).Days))
            </p>
        }
        else
        {
            <div class="mb-3"></div>
        }
        @if (Model.Mensaje != null)
        {
            <div class="alert alert-success">@Model.Mensaje</div>
        }

        @if (Model.Error != null)
        {
            <div class="alert alert-danger">@Model.Error</div>
        }

        <form method="post" enctype="multipart/form-data">
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3">Datos</h2>

                    <div class="mb-3">
                        <label asp-for="Datos.Nombre" class="form-label">Nombre</label>
                        <input asp-for="Datos.Nombre" class="form-control" />
                        <span asp-validation-for="Datos.Nombre" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Datos.EspecieId" class="form-label">Especie</label>
                            <select asp-for="Datos.EspecieId" asp-items="@(new SelectList(Model.Especies, "Id", "Nombre"))"
                                    class="form-select" required>
                                <option value="">Elegí una especie</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Datos.Raza" class="form-label">Raza <span class="text-muted">(opcional)</span></label>
                            <input asp-for="Datos.Raza" class="form-control" placeholder="Ej: Mestizo" />
                            <span asp-validation-for="Datos.Raza" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Datos.Sexo" class="form-label">Sexo</label>
                            <select asp-for="Datos.Sexo" class="form-select">
                                <option value="">Sin datos</option>
                                <option value="Macho">Macho</option>
                                <option value="Hembra">Hembra</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Datos.Tamanio" class="form-label">Tamaño</label>
                            <select asp-for="Datos.Tamanio" class="form-select">
                                <option value="">Sin datos</option>
                                <option value="Chico">Chico</option>
                                <option value="Mediano">Mediano</option>
                                <option value="Grande">Grande</option>
                            </select>
                        </div>
                    </div>

                    <label class="form-label d-block">Edad <span class="text-muted">(opcional)</span></label>
                    <div class="mb-2">
                        <div class="form-check form-check-inline">
                            <input asp-for="CargarConFecha" type="radio" value="False" id="modo-edad" class="form-check-input" />
                            <label class="form-check-label" for="modo-edad">Sé la edad aproximada</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input asp-for="CargarConFecha" type="radio" value="True" id="modo-fecha" class="form-check-input" />
                            <label class="form-check-label" for="modo-fecha">Sé la fecha de nacimiento</label>
                        </div>
                    </div>

                    <div id="bloque-edad">
                        <div class="row mb-1">
                            <div class="col-4">
                                <div class="input-group">
                                    <input asp-for="Anios" type="number" min="0" max="30" class="form-control" />
                                    <span class="input-group-text">años</span>
                                </div>
                                <span asp-validation-for="Anios" class="text-danger small"></span>
                            </div>
                            <div class="col-4">
                                <div class="input-group">
                                    <input asp-for="Meses" type="number" min="0" max="11" class="form-control" />
                                    <span class="input-group-text">meses</span>
                                </div>
                                <span asp-validation-for="Meses" class="text-danger small"></span>
                            </div>
                            <div class="col-4">
                                <div class="input-group">
                                    <input asp-for="Dias" type="number" min="0" max="60" class="form-control" /> 
                                    <span class="input-group-text">días</span>
                                </div>
                                <span asp-validation-for="Dias" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="form-text mb-3">
                            Para un cachorro podés poner solo los días (hasta 60). Si no sabés la edad, dejalo vacío.
                        </div>
                    </div>

                    <div id="bloque-fecha">
                        <input asp-for="Datos.FechaNacimientoAproximada" type="date" class="form-control"
                               max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <div class="form-text mb-3">Por ejemplo, si nació en el refugio o tiene libreta del veterinario.</div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3">Salud</h2>

                    <div class="mb-3">
                        <label asp-for="Datos.CondicionId" class="form-label">Condición</label>
                        <select asp-for="Datos.CondicionId" asp-items="@(new SelectList(Model.Condiciones, "Id", "Nombre"))"
                                class="form-select" required>
                            <option value="">Elegí una condición</option>
                        </select>
                    </div>

                    <div class="form-check">
                        <input asp-for="Datos.Vacunado" class="form-check-input" />
                        <label asp-for="Datos.Vacunado" class="form-check-label">Tiene las vacunas al día</label>
                    </div>
                </div>
            </div>

            @if (esNueva)
            {
                <div class="card mb-4">
                    <div class="card-body">
                        <h2 class="h5 mb-1">Fotos <span class="text-muted small">(opcional)</span></h2>
                        <p class="text-muted small mb-3">Podés elegir varias. La primera va a ser la principal , después la podés cambiar.</p>
                        <input asp-for="FotosNuevas" type="file" multiple class="form-control" accept="image/jpeg,image/png,image/webp" />
                        <div class="form-text">jpg, png o webp, hasta 5 MB cada una.</div>
                    </div>
                </div>
            }

            @if (!esNueva)
            {
                <p class="small text-muted">El estado (en refugio, en tránsito, adoptada) no se edita: lo cambian las entregas, devoluciones y conversiones.</p>
            }

            <button type="submit" class="btn btn-primary w-100 mb-5">
                @(esNueva ? "Crear mascota" : "Guardar cambios")
            </button>
        </form>
        @* Fotos de animales *@
        @if (Model.Mascota != null)
        {
            var ids = Model.Mascota.FotosIds;
            var urls = Api.UrlsFotosMascota(ids);

            <div class="card mb-5">
                <div class="card-body">
                    <h2 class="h5 mb-1">Fotos</h2>
                    <p class="text-muted small mb-3">La primera es la principal: es la que se ve en las tarjetas. Podés subir varias a la vez.</p>

                    @if (Model.ErrorFotos != null)
                    {
                        <div class="alert alert-danger">@Model.ErrorFotos</div>
                    }

                    @if (!ids.Any())
                    {
                        <p class="text-muted small">Todavía no tiene fotos.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-3 mb-3">
                            @for (var i = 0; i < ids.Count; i++)
                            {
                                <div class="text-center">
                                    <img src="@urls[i]" class="foto-mascota-mini rounded @(i == 0 ? "foto-principal" : "")" alt="Foto @(i + 1) de @Model.Mascota.Nombre" />

                                    <div class="mt-1">
                                        @if (i == 0)
                                        {
                                            <span class="badge bg-primary">Principal</span>
                                        }
                                        else
                                        {
                                            <form method="post" asp-page-handler="HacerPrincipal" asp-route-id="@Model.Id" asp-route-fotoId="@ids[i]" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-link p-0">Hacer principal</button>
                                            </form>
                                        }
                                    </div>

                                    <form method="post" asp-page-handler="BorrarFoto" asp-route-id="@Model.Id" asp-route-fotoId="@ids[i]"
                                          onsubmit="return confirm('¿Borrar esta foto?');">
                                        <button type="submit" class="btn btn-sm btn-link text-danger p-0">Borrar</button>
                                    </form>
                                </div>
                            }
                        </div>
                    }

                    <form method="post" asp-page-handler="SubirFotos" asp-route-id="@Model.Id" enctype="multipart/form-data"
                          class="d-flex gap-2">
                        <input asp-for="FotosNuevas" type="file" multiple class="form-control" accept="image/jpeg,image/png,image/webp" />
                        <button type="submit" class="btn btn-outline-primary flex-shrink-0">Subir</button>
                    </form>
                    <div class="form-text">jpg, png o webp, hasta 5 MB cada una.</div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        //muestra solo la opcion elegida, (edad o fecha aprox)
        function mostrarModoEdad() {
            var conFecha = document.getElementById('modo-fecha').checked;
            document.getElementById('bloque-fecha').hidden = !conFecha;
            document.getElementById('bloque-edad').hidden = conFecha;
        }

        document.getElementById('modo-edad').addEventListener('change', mostrarModoEdad);
        document.getElementById('modo-fecha').addEventListener('change', mostrarModoEdad);
        mostrarModoEdad();
    </script>
}