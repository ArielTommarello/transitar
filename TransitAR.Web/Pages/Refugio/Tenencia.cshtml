@page "{id:guid}"
@model TransitAR.Web.Pages.Refugio.TenenciaModel
@{
    ViewData["Title"] = Model.Tenencia?.MascotaNombre ?? "Tenencia";
}

<a asp-page="/Refugio/Tenencias" class="small">&larr; Volver a Tenencias</a>

@if (Model.Tenencia == null)
{
    <div class="text-center py-5">
        <h1 class="h4">No encontramos esta tenencia</h1>
        <p class="text-muted">Puede que el link esté mal o que no sea de tu refugio.</p>
        <a asp-page="/Refugio/Tenencias" class="btn btn-primary">Ir a Tenencias</a>
    </div>
    return;
}

@{
    var t = Model.Tenencia;
    var foto = Api.UrlFotoPrincipal(t.FotosIds);
    var veredicto = Formato.VeredictoTenencia(t);
    var esTransito = t.Modalidad == TipoPublicacion.Transito;
}

@if (Model.Mensaje != null)
{
    <div class="alert alert-success mt-3">@Model.Mensaje</div>
}

@if (Model.Error != null)
{
    <div class="alert alert-danger mt-3">@Model.Error</div>
}

<div class="row g-4 mt-1">
    @* -- Datos -- *@
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex gap-3 align-items-start mb-3">
                    @if (foto != null)
                    {
                        <img src="@foto" class="mascota-mini rounded" alt="Foto de @t.MascotaNombre" />
                    }
                    else
                    {
                        <div class="mascota-mini tarjeta-sin-foto rounded"></div>
                    }
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <h1 class="h3 mb-0">
                                <a asp-page="/Refugio/Mascota" asp-route-id="@t.MascotaId" class="text-reset">@t.MascotaNombre</a>
                            </h1>
                            <span class="badge @Formato.ColorTenencia(t)">@Formato.EtiquetaTenencia(t)</span>
                        </div>
                        <div class="text-muted">@t.EspecieNombre · @Formato.Tipo(t.Modalidad)</div>
                    </div>
                </div>

                <ul class="list-unstyled mb-3">
                    <li>
                        <strong>Con quién:</strong>
                        <a asp-page="/Refugio/Postulante" asp-route-publicacionId="@t.PublicacionId" asp-route-postulacionId="@t.PostulacionId">
                            @t.Nombre @t.Apellido
                        </a>
                    </li>
                    <li><strong>Se la entregaste el:</strong> @Formato.FechaDe(t.FechaInicio)</li>
                    @if (t.FechaFinEstimada != null && Model.EnCurso)
                    {
                        <li><strong>Devolución pactada:</strong> @Formato.Dia(t.FechaFinEstimada.Value)</li>
                    }
                    @if (t.FechaConversion != null)
                    {
                        <li><strong>Pasó a adopción el:</strong> @Formato.FechaDe(t.FechaConversion.Value)</li>
                    }
                    @if (t.FechaFinReal != null)
                    {
                        <li><strong>Volvió al refugio el:</strong> @Formato.FechaDe(t.FechaFinReal.Value)</li>
                    }
                    <li>@(Model.EnCurso ? $"Lleva {Formato.Dias(t.DuracionEnDias)}." : $"Duró {Formato.Dias(t.DuracionEnDias)}.")</li>
                </ul>

                @if (t.EstaVencida)
                {
                    <div class="alert alert-warning mb-0">
                        La fecha pactada ya pasó. Coordiná la devolución, o pasala a adopción si se la queda.
                    </div>
                }

                @if (veredicto != null)
                {
                    <div class="border-top pt-3">
                        <p class="mb-1"><strong>@veredicto</strong></p>
                        @if (!string.IsNullOrWhiteSpace(t.ObservacionCierre))
                        {
                            <p class="small mb-0 texto-con-saltos">Tu comentario: @t.ObservacionCierre</p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @* -- Acciones -- *@
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 mb-3">Acciones</h2>

                @if (!Model.EnCurso)
                {
                    <p class="text-muted mb-0">Esta tenencia terminó. Si querés volver a ofrecer a @t.MascotaNombre, creá una publicación nueva.</p>
                }
                else
                {
                    @if (esTransito)
                    {
                        <form method="post" asp-page-handler="Convertir" class="mb-4"
                              onsubmit="return confirm('¿@t.Nombre se queda con @t.MascotaNombre? El tránsito pasa a ser una adopción definitiva.');">
                            <button type="submit" class="btn btn-success w-100">Pasar a adopción</button>
                            <div class="form-text">Si decidió quedárselo. Es la misma tenencia: no hace falta otra entrega.</div>
                        </form>
                    }

                    <form method="post" asp-page-handler="Devolver"
                          onsubmit="return confirm('¿Registrar que @t.MascotaNombre volvió al refugio? Los controles pendientes se cancelan.');">
                        <p class="mb-2"><strong>¿Cómo terminó?</strong></p>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="FinalizoBien" id="terminoBien" value="true" />
                            <label class="form-check-label" for="terminoBien">Terminó bien</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="FinalizoBien" id="huboInconvenientes" value="false" />
                            <label class="form-check-label" for="huboInconvenientes">Hubo inconvenientes</label>
                        </div>
                        <div class="mb-2">
                            <label asp-for="ObservacionCierre" class="form-label">Comentario (opcional)</label>
                            <textarea asp-for="ObservacionCierre" class="form-control" rows="2"></textarea>
                            <div class="form-text">Lo van a ver otros refugios en su historial.</div>
                        </div>
                        <button type="submit" class="btn btn-outline-danger w-100">Registrar devolución</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@* -- Controles -- *@
<div class="card mt-4 mb-5">
    <div class="card-body">
        <h2 class="h5 mb-3">Controles de seguimiento</h2>

        @* Programar*@
        @if (Model.EnCurso)
        {
            <form method="post" asp-page-handler="Programar" class="row g-2 align-items-end mb-4">
                <div class="col-sm-6 col-md-4">
                    <label for="fechaControl" class="form-label">Programar un control</label>
                    <input type="date" id="fechaControl" name="FechaControl" class="form-control"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Programar</button>
                </div>
            </form>
        }

        @if (!Model.Controles.Any())
        {
            <p class="text-muted small mb-0">Todavía no hay controles para esta tenencia.</p>
        }

        @* Pendientes *@
        @if (Model.Pendientes.Any())
        {
            <h3 class="h6 text-muted">Por hacer</h3>
            <ul class="list-group list-group-flush mb-4">
                @foreach (var c in Model.Pendientes)
                {
                    <li class="list-group-item px-0">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong>@Formato.Dia(c.FechaProgramada)</strong>
                            <span class="badge @Formato.ColorControl(c)">@Formato.EstadoControl(c)</span>
                        </div>

                        @if (Model.EnCurso)
                        {
                            <form method="post" class="row g-2 align-items-end">
                                <div class="col-md-6">
                                    <label for="comentario-@c.Id" class="form-label small mb-1">Comentario (opcional)</label>
                                    <textarea id="comentario-@c.Id" name="ComentarioControl" class="form-control form-control-sm" rows="1"></textarea>
                                    <div class="form-text">Lo ve la persona en su ficha.</div>
                                </div>
                                <div class="col-sm-6 col-md-3">
                                    <label for="fecha-@c.Id" class="form-label small mb-1">Día nuevo (solo reprogramar)</label>
                                    <input type="date" id="fecha-@c.Id" name="FechaReprogramada" class="form-control form-control-sm"
                                           min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                    <div class="form-text">&nbsp;</div>
                                </div>
                                <div class="col-md-3 d-flex flex-wrap gap-1 pb-4">
                                    <button type="submit" asp-page-handler="Realizado" asp-route-controlId="@c.Id"
                                            class="btn btn-sm btn-success">
                                        Realizado
                                    </button>
                                    <button type="submit" asp-page-handler="Reprogramar" asp-route-controlId="@c.Id"
                                            class="btn btn-sm btn-outline-primary">
                                        Reprogramar
                                    </button>
                                    <button type="submit" asp-page-handler="Cancelar" asp-route-controlId="@c.Id"
                                            class="btn btn-sm btn-outline-secondary"
                                            onclick="return confirm('¿Cancelar el control del @Formato.Dia(c.FechaProgramada)?');">
                                        Cancelar
                                    </button>
                                </div>
                            </form>
                        }
                    </li>
                }
            </ul>
        }

        @* Resueltos *@
        @if (Model.Resueltos.Any())
        {
            <h3 class="h6 text-muted">Resueltos</h3>
            <ul class="list-group list-group-flush">
                @foreach (var c in Model.Resueltos)
                {
                    <li class="list-group-item px-0">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>
                                @Formato.Dia(c.FechaProgramada)
                                @if (c.FechaRealizada != null)
                                {
                                    <span class="small text-muted">· hecho el @Formato.FechaDe(c.FechaRealizada.Value)</span>
                                }
                            </span>
                            <span class="badge @Formato.ColorControl(c)">@Formato.EstadoControl(c)</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(c.Observacion))
                        {
                            <p class="small text-muted mb-0 mt-1 texto-con-saltos">@c.Observacion</p>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</div>