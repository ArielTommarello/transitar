@page
@model TransitAR.Web.Pages.Refugio.PublicacionesModel
@{
    ViewData["Title"] = "Publicaciones";

    var filtros = new (EstadoPublicacion? Estado, string Nombre)[]
    {
        (EstadoPublicacion.Activa, "Activas"),
        (EstadoPublicacion.Pausada, "Pausadas"),
        (EstadoPublicacion.Cerrada, "Cerradas"),
        (null, "Todas")
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Publicaciones</h1>
    <a asp-page="/Refugio/Publicacion" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nueva publicación</a>
</div>

@if (Model.Mensaje != null)
{
    <div class="alert alert-success">@Model.Mensaje</div>
}

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<ul class="nav nav-pills mb-3">
    @foreach (var f in filtros)
    {
        <li class="nav-item">
            <a asp-page="/Refugio/Publicaciones" asp-route-estado="@f.Estado"
               class="nav-link @(Model.Estado == f.Estado ? "active" : "")">
                @f.Nombre <span class="badge bg-light text-dark ms-1">@Model.Cantidad(f.Estado)</span>
            </a>
        </li>
    }
</ul>

@if (!Model.Todas.Any())
{
    <partial name="_AvisoSinDatos" model='new AvisoSinDatos("bi-megaphone", "Todavía no publicaste ninguna mascota.", BotonTexto: "Crear la primera", BotonUrl: Url.Page("/Refugio/Publicacion"))' />
}
else if (!Model.Publicaciones.Any())
{
    <partial name="_AvisoSinDatos" model='new AvisoSinDatos("bi-inbox", "No hay publicaciones para mostrar.")' />
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th></th>
                    <th>Publicación</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Fecha</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Publicaciones)
                {
                    var foto = Api.UrlFotoPrincipal(p.FotosIds);
                    var abierta = p.Estado != EstadoPublicacion.Cerrada;

                    <tr>
                        <td>
                            @if (foto != null)
                            {
                                <img src="@foto" class="mascota-mini rounded" alt="Foto de @p.MascotaNombre" />
                            }
                            else
                            {
                                <div class="mascota-mini tarjeta-sin-foto rounded"></div>
                            }
                        </td>
                        <td>
                            <strong>@p.Titulo</strong>
                            <div class="small text-muted">@p.MascotaNombre</div>
                            <a asp-page="/Refugio/Postulantes" asp-route-id="@p.Id" class="small">
                                Postulaciones (@p.CantidadPostulaciones)
                            </a>
                        </td>
                        <td>@Formato.Tipo(p.Tipo)</td>
                        <td><span class="badge @Formato.ColorEstadoPublicacion(p.Estado)">@Formato.EstadoPublicacion(p.Estado)</span></td>
                        <td class="small">
                            Publicada el @Formato.FechaDe(p.FechaPublicacion)
                            @if (p.FechaCierre != null)
                            {
                                <div class="text-muted">Cerrada el @Formato.FechaDe(p.FechaCierre.Value)</div>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (p.Estado == EstadoPublicacion.Activa)
                            {
                                <a asp-page="/Publicaciones/Detalle" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye me-1"></i>Ver aviso</a>
                            }

                            @if (abierta)
                            {
                                <a asp-page="/Refugio/Publicacion" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil me-1"></i>Editar</a>
                            }
                            else
                            {
                                <a asp-page="/Refugio/Publicacion" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye me-1"></i>Ver</a>
                                <a asp-page="/Refugio/Publicacion" asp-route-reusar="@p.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-arrow-repeat me-1"></i>Reusar</a>
                            }

                            @if (p.Estado == EstadoPublicacion.Activa)
                            {
                                <form method="post" asp-page-handler="CambiarEstado" asp-route-id="@p.Id"
                                      asp-route-nuevoEstado="@EstadoPublicacion.Pausada" asp-route-estado="@Model.Estado" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-warning"><i class="bi bi-pause-circle me-1"></i>Pausar</button>
                                </form>
                            }

                            @if (p.Estado == EstadoPublicacion.Pausada)
                            {
                                <form method="post" asp-page-handler="CambiarEstado" asp-route-id="@p.Id"
                                      asp-route-nuevoEstado="@EstadoPublicacion.Activa" asp-route-estado="@Model.Estado" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success"><i class="bi bi-play-circle me-1"></i>Reanudar</button>
                                </form>
                            }

                            @if (abierta)
                            {
                                <form method="post" asp-page-handler="CambiarEstado" asp-route-id="@p.Id"
                                      asp-route-nuevoEstado="@EstadoPublicacion.Cerrada" asp-route-estado="@Model.Estado" class="d-inline"
                                      data-confirmar="¿Cerrar esta publicación? Es definitivo: no se puede reabrir, y las postulaciones que siguen abiertas se rechazan." data-confirmar-boton="Cerrar publicación">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-circle me-1"></i>Cerrar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    var prevDisabled = !Model.Publicaciones.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.Publicaciones.HasNextPage ? "disabled" : "";

    <nav aria-label="Paginación">
        <ul class="pagination pagination-sm justify-content-center align-items-center gap-3 mt-4">
            <li class="page-item @prevDisabled">
                <a class="page-link rounded" asp-page="./Publicaciones" asp-route-estado="@Model.Estado"
                   asp-route-pageIndex="@(Model.Publicaciones.PageIndex - 1)"><i class="bi bi-chevron-left me-1"></i>Anterior</a>
            </li>
            <li class="page-item disabled">
                <a class="page-link border-0 bg-transparent">Página @Model.Publicaciones.PageIndex de @Model.Publicaciones.TotalPages</a>
            </li>
            <li class="page-item @nextDisabled">
                <a class="page-link rounded" asp-page="./Publicaciones" asp-route-estado="@Model.Estado"
                   asp-route-pageIndex="@(Model.Publicaciones.PageIndex + 1)">Siguiente<i class="bi bi-chevron-right ms-1"></i></a>
            </li>
        </ul>
    </nav>
}