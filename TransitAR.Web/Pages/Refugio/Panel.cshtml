@page
@model TransitAR.Web.Pages.Refugio.PanelModel
@{
    ViewData["Title"] = "Panel";
    
    void Tarjeta(string texto, int? numero, string? url, bool atender = false)
    {
        <div class="col">
            <a href="@url" class="card h-100 text-decoration-none @(atender && numero > 0 ? "border-warning bg-warning-subtle" : "")">
                <div class="card-body">
                    <div class="display-6 text-body">@(numero?.ToString() ?? "—")</div>
                    <div class="text-muted small">@texto</div>
                </div>
            </a>
        </div>
    }
}

<h1 class="h3 mb-4">Panel del refugio</h1>

<partial name="_AvisoControles" model="Model.ProximosDias" />

<h2 class="h5 mb-3">Para atender</h2>
<div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-3 mb-5">
    @{
        Tarjeta("Postulaciones por revisar", Model.PorRevisar, Url.Page("/Refugio/Publicaciones"), true);
        Tarjeta("Controles atrasados", Model.ControlesAtrasados, Url.Page("/Refugio/Seguimiento"), true);
        Tarjeta("Tenencias vencidas", Model.TenenciasVencidas, Url.Page("/Refugio/Tenencias", new { vista = VistaTenencias.Vencidas }), true);
        Tarjeta("Tenencias sin controles", Model.SinControles, Url.Page("/Refugio/Tenencias", new { vista = VistaTenencias.SinControlesPendientes }), true);
        Tarjeta("Mensajes sin leer", Model.SinLeer, Url.Page("/Mensajes/Index"), true);
    }
</div>

<h2 class="h5 mb-3">Hoy</h2>
<div class="row row-cols-2 row-cols-md-4 g-3 mb-5">
    @{
        Tarjeta("Mascotas en el refugio", Model.EnRefugio, Url.Page("/Refugio/Mascotas", new { estado = EstadoMascota.EnRefugio }));
        Tarjeta("Publicaciones activas", Model.Activas, Url.Page("/Refugio/Publicaciones", new { estado = EstadoPublicacion.Activa }));
        Tarjeta("Publicaciones pausadas", Model.Pausadas, Url.Page("/Refugio/Publicaciones", new { estado = EstadoPublicacion.Pausada }));
        Tarjeta("Tenencias en curso", Model.EnCurso, Url.Page("/Refugio/Tenencias", new { vista = VistaTenencias.EnCurso }));
    }
</div>

<h2 class="h5 mb-3">Historia del refugio</h2>
<div class="row row-cols-2 row-cols-md-4 g-3 mb-5">
    @{
        Tarjeta("Adopciones logradas", Model.Adoptadas, Url.Page("/Refugio/Mascotas", new { estado = EstadoMascota.Adoptada }));
        Tarjeta("Tenencias terminadas", Model.Finalizadas, Url.Page("/Refugio/Tenencias", new { vista = VistaTenencias.Finalizadas }));
    }
</div>